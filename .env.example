# Copy to .env (which is git-ignored) and fill in. Never commit real keys.

# Secret used to derive deterministic per-domain verification tokens.
REDLINE_SECRET=change-me-in-production

# Optional: enables the AI remediation summary via Groq's OpenAI-compatible API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local testing only: skip the ownership verification gate (do NOT set in prod).
# REDLINE_ALLOW_UNVERIFIED=1
